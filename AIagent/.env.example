# ===== Claude Code CLI配置（核心）=====
CLAUDE_CODE_PATH=/usr/local/bin/claude
CLAUDE_CODE_TIMEOUT=300
CLAUDE_CODE_MAX_CONCURRENT=2
CLAUDE_CODE_WORKING_DIR=/mnt/f/work/zq-platform

# ===== LLM配置（用于RAG等智能体）=====
# LLM提供商：anthropic, openai, local, azure_openai等
# DeepSeek等OpenAI兼容API使用：LLM_PROVIDER=openai + LLM_BASE_URL
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key
# 支持LLM_MODEL或LLM_MODEL_NAME（如果使用项目根目录.env的LLM_MODEL_NAME格式）
LLM_MODEL=deepseek-reasoner
# LLM_MODEL_NAME=deepseek-reasoner  # 如果项目根目录使用LLM_MODEL_NAME，取消注释此行
LLM_MAX_TOKENS=32000
LLM_TEMPERATURE=0.1
# DeepSeek等OpenAI兼容API的端点
LLM_BASE_URL=https://api.deepseek.com

# ===== 向量数据库配置 =====
VECTOR_DB_TYPE=chromadb
CHROMA_PERSIST_DIR=./data/chroma

# ===== 记忆系统配置 =====
MEMORY_BACKEND=redis
REDIS_URL=redis://localhost:6379/1
MEMORY_TTL=86400

# ===== 日志配置 =====
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_FORMAT=json

# ===== RAG配置 =====
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=your_embedding_api_key
