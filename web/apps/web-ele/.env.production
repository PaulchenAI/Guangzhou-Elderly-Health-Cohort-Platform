# 生产环境配置
# 详细配置说明请参考: docs/src/guide/essentials/settings.md

# 应用标题
VITE_APP_TITLE=芷青开发平台

# 应用命名空间（用于缓存、存储等）
VITE_APP_NAMESPACE=zq-platform

# 基础路径
VITE_BASE=/

# API 接口地址（生产环境直接请求后端）
VITE_GLOB_API_URL=https://django-ninja.zq-platform.cn

# 是否启用压缩 (gzip | brotli | gzip,brotli | none)
VITE_COMPRESS=gzip

# 是否启用 PWA
VITE_PWA=false

# 路由模式 (hash | history)
VITE_ROUTER_HISTORY=history

# 是否注入全局 loading
VITE_INJECT_APP_LOADING=true

# 是否打包分析
VITE_ARCHIVER=false
