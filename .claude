# Claude Code 配置文件
# 适用于 zq-platform 项目

[model]
# 指定在该项目中使用的模型
name = "qwen3-coder-plus"

[project]
# 项目特定的配置
name = "zq-platform"
language = "zh-CN"  # 使用中文交流

[rules]
# 代码风格规则
follow_pep8 = true  # Python 代码遵循 PEP 8
typescript_strict_mode = true  # TypeScript 严格模式
utf8_encoding_required = true  # 强制使用 UTF-8 编码

[conventions]
# 项目约定
backend_framework = "django-ninja"
frontend_framework = "vue3"
database_support = ["mysql", "postgresql", "sqlserver", "sqlite"]

[security]
# 安全扫描规则
scan_secrets = true  # 扫描密钥
avoid_hardcoded_credentials = true  # 避免硬编码凭证

[context]
# 项目上下文信息
include_openspec = true  # 在分析中包含 OpenSpec 规范
prioritize_chinese_docs = true  # 优先使用中文文档

